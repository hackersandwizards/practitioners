---
// The catalog's home: the tiles of the components, then one tile per brand element the pages use,
// drawn by the hub's own component where one exists. brand-elements.json lists the elements;
// brand-elements measures every tile against brand's own rule and fails on a used element
// without a tile.
import { getCollection } from "astro:content";
import Home from "@hackersandwizards/scaffolding/catalog/Home.astro";
import ThemeToggle from "@hackersandwizards/brand/expert/components/ThemeToggle.astro";
import { version } from "@hackersandwizards/brand/package.json";
import Links from "../src/components/Links.astro";
import PersonCard from "../src/components/PersonCard.astro";
import { card, entry } from "./stories/entries";

const reachy = await card("reachy");
const all = await getCollection("practitioners");
const drafts = all.filter((e) => e.data.status === "draft").length;
---

<Home>
  <ThemeToggle slot="nav" />
  <h3>Brand elements</h3>
  <p>
    Each element as a page of this hub draws it, from brand {version}. A part of its own fails the
    gate's element check.
  </p>
  <ul class="mt-4 grid gap-4 sm:grid-cols-2">
    <li class="grid content-start gap-3" data-hw-tile="card" data-hw-version={version}>
      <p class="text-small text-muted">Card: one person on the overview</p>
      <ul class="max-w-60">
        <PersonCard {...reachy} />
      </ul>
    </li>
    <li class="grid content-start gap-3" data-hw-tile="pill" data-hw-version={version}>
      <p class="text-small text-muted">Pill: a draft, someone the website does not list</p>
      <p class="flex flex-wrap gap-1.5">
        <span class="hw-pill" data-state="draft">
          Draft
        </span>
        <span class="hw-pill" data-variant="outline">
          Not on the website
        </span>
      </p>
    </li>
    <li class="grid content-start gap-3" data-hw-tile="arrow-link" data-hw-version={version}>
      <p class="text-small text-muted">Arrow link: a profile outside</p>
      <Links data={(await entry("bastian-weinlich")).data} />
    </li>
    <li class="grid content-start gap-3" data-hw-tile="callout" data-hw-version={version}>
      <p class="text-small text-muted">Callout: the website's team page could not be read</p>
      <p class="hw-callout text-small">The website's team page could not be read.</p>
    </li>
    <li class="grid content-start gap-3" data-hw-tile="field" data-hw-version={version}>
      <p class="text-small text-muted">Field: the text field inside the search</p>
      <input type="text" class="hw-field" placeholder="Find a name" aria-label="Find a name" />
    </li>
    <li class="grid content-start gap-3" data-hw-tile="search" data-hw-version={version}>
      <p class="text-small text-muted">Search field: find a name</p>
      <div class="hw-search">
        <input type="search" class="hw-field" placeholder="Find a name" aria-label="Find a name" />
      </div>
    </li>
    <li class="grid content-start gap-3" data-hw-tile="button" data-hw-version={version}>
      <p class="text-small text-muted">Button: send the search</p>
      <button type="button" class="hw-button justify-self-start" data-variant="secondary">
        Search
      </button>
    </li>
    <li class="grid content-start gap-3" data-hw-tile="form-field" data-hw-version={version}>
      <p class="text-small text-muted">Form field: the filter's legend over its values</p>
      <fieldset class="hw-form-field">
        <legend class="hw-form-label">Show</legend>
        <p class="text-small text-muted">All, drafts, or not on the website</p>
      </fieldset>
    </li>
    <li class="grid content-start gap-3" data-hw-tile="choice" data-hw-version={version}>
      <p class="text-small text-muted">
        Choice: one value of the overview's filter, with its count
      </p>
      <div class="hw-choices" role="group" aria-label="Show">
        <label class="hw-choice">
          <input type="radio" name="show" value="" checked />
          All <span class="hw-choice-count">{all.length}</span>
        </label>
        <label class="hw-choice">
          <input type="radio" name="show" value="draft" />
          Drafts <span class="hw-choice-count">{drafts}</span>
        </label>
      </div>
    </li>
    <li class="grid content-start gap-3" data-hw-tile="link" data-hw-version={version}>
      <p class="text-small text-muted">Link in running text: a bio's links</p>
      <p class="hw-links">
        Read the <a href="/">overview</a>.
      </p>
    </li>
    <li class="grid content-start gap-3" data-hw-tile="breadcrumb" data-hw-version={version}>
      <p class="text-small text-muted">Breadcrumb: back to the overview</p>
      <nav class="hw-breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li>
            <a href="/">Practitioners</a>
          </li>
          <li>
            <span aria-current="page">Name</span>
          </li>
        </ol>
      </nav>
    </li>
    <li class="grid content-start gap-3" data-hw-tile="status" data-hw-version={version}>
      <p class="text-small text-muted">Status box: what an entry still lacks</p>
      <div class="hw-status" data-tone="warning">
        <p>Still missing: German bio, LinkedIn.</p>
      </div>
    </li>
    <li class="grid content-start gap-3" data-hw-tile="label" data-hw-version={version}>
      <p class="text-small text-muted">Label: a profile fact's name</p>
      <p class="hw-label" data-tone="muted">
        Works for
      </p>
    </li>
    <li class="grid content-start gap-3" data-hw-tile="facts" data-hw-version={version}>
      <p class="text-small text-muted">Facts: the profile for matching</p>
      <dl class="hw-facts">
        <div>
          <dt class="hw-label" data-tone="muted">
            Works for
          </dt>
          <dd>
            <span class="hw-pill" data-tone="neutral">
              Freelance
            </span>
          </dd>
        </div>
      </dl>
    </li>
    <li class="grid content-start gap-3" data-hw-tile="focus-ring" data-hw-version={version}>
      <p class="text-small text-muted">Focus ring: focus the link</p>
      <a href="/">Overview</a>
    </li>
  </ul>
</Home>
