---
// The brand's focus selectors already match `data-hw-focus`, so only hover needs mirrored rules.
interface Props {
  grid?: boolean;
  state?: "hover" | "focus";
}
const { grid, state } = Astro.props;
const List = grid ? "ul" : "div";
---

<div class="p-6" data-force-state={state}>
  <List class:list={[grid && "grid max-w-60"]} data-hw-preview>
    <slot />
  </List>
</div>

<script>
  function mirrorHoverRule(rule: CSSRule, parent: CSSStyleSheet | CSSGroupingRule, index: number) {
    if (rule instanceof CSSStyleRule) {
      const selector = rule.selectorText.replaceAll(":hover", '[data-force="hover"]');
      if (selector !== rule.selectorText)
        try {
          parent.insertRule(`${selector}{${rule.style.cssText}}`, index + 1);
        } catch (error) {
          // A selector the swap made invalid, such as an attribute after ::part().
          if (!(error instanceof DOMException) || error.name !== "SyntaxError") throw error;
        }
    }
    // A style rule holds nested rules too, such as `&:hover`.
    if ("cssRules" in rule && rule.cssRules instanceof CSSRuleList)
      mirror(rule.cssRules, rule as CSSGroupingRule);
  }

  function mirror(rules: CSSRuleList, parent: CSSStyleSheet | CSSGroupingRule) {
    for (let i = rules.length - 1; i >= 0; i--) mirrorHoverRule(rules[i], parent, i);
  }

  function mirrorHoverSheet(sheet: CSSStyleSheet) {
    let rules: CSSRuleList;
    try {
      rules = sheet.cssRules;
    } catch (error) {
      // A cross-origin sheet has no readable rules.
      if (!(error instanceof DOMException) || error.name !== "SecurityError") throw error;
      return;
    }
    mirror(rules, sheet);
  }

  for (const box of document.querySelectorAll<HTMLElement>('[data-force-state="focus"]'))
    box.querySelector("a[href]")?.setAttribute("data-hw-focus", "");
  const hovered = [...document.querySelectorAll<HTMLElement>('[data-force-state="hover"]')];
  try {
    if (hovered.length) for (const sheet of document.styleSheets) mirrorHoverSheet(sheet);
  } finally {
    for (const box of hovered)
      for (let node = box.querySelector("a[href]"); node && node !== box; node = node.parentElement)
        node.setAttribute("data-force", "hover");
  }
</script>
