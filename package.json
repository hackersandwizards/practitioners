{
  "name": "practitioners",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "postinstall": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "printf 'Caddy: http://practitioners.localhost\\n' && astro dev",
    "build": "astro build",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun scripts/check-inline-space.ts && bun run typecheck && bun run build && PREVIEW=1 astro build --outDir .preview"
  },
  "dependencies": {
    "@hackersandwizards/brand": "git+https://github.com/hackersandwizards/brand.git#v1.16.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/bun": "1.4.4",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}
