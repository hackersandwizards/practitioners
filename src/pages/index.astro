---
// Everyone in this repo as hackersandwizards.dev/team/ shows them, alphabetical, each card opening
// the person's page. Grouping is the website's roster, so nothing here is grouped; the website's
// published team page says who it lists and with which role (lib/website.ts).
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PersonCard from "../components/PersonCard.astro";
import { repo, shown } from "../lib/entry";
import { roster, team } from "../lib/website";

const web = await roster();
const people = (await getCollection("practitioners", (e) => shown(e.data))).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const unlisted = (name: string) => Boolean(web && !web.has(name));
const filters = [
  { key: "all", label: "All", count: people.length },
  { key: "draft", label: "Drafts", count: people.filter((e) => e.data.status === "draft").length },
  ...(web
    ? [
        {
          key: "unlisted",
          label: "Not on the website",
          count: people.filter((e) => unlisted(e.data.name)).length,
        },
      ]
    : []),
];
---

<Layout title="Practitioners" bleed>
  <div class="mx-auto w-full max-w-content px-gutter pb-section">
    <h1 class="mt-8 font-mono text-h2 font-bold tracking-tight">Practitioners</h1>
    <p class="mt-2 max-w-measure text-muted">
      Each card shows a person as{" "}
      <a href={team} class="hw-link">
        hackersandwizards.dev/team
      </a>{" "}
      shows them. Open a card to read and check the full entry.
    </p>
    <p class="mt-3 max-w-measure text-small text-muted">
      Each person improves their own entry by pull request, as{" "}
      <a href={`${repo}/blob/main/CONTRIBUTING.md`} class="hw-link">
        CONTRIBUTING.md
      </a>{" "}
      describes.
    </p>
    {!web && (
      <p class="mt-3 hw-callout max-w-measure text-small">
        The website's team page could not be read when this page was built, so roles and who is not
        on the website yet are missing.
      </p>
    )}

    <div class="mt-8 flex flex-wrap items-center gap-4" id="controls" hidden>
      <input
        type="search"
        id="find"
        class="hw-field w-full sm:w-72"
        placeholder="Find a name"
        aria-label="Find a name"
        aria-controls="people"
      />
      <div class="hw-segmented max-sm:flex max-sm:w-full" role="group" aria-label="Show">
        {filters.map((f) => (
          <button
            type="button"
            class="max-sm:grow"
            data-filter={f.key}
            aria-pressed={f.key === "all" ? "true" : "false"}
          >
            {f.label} {f.count}
          </button>
        ))}
      </div>
    </div>

    <ul class="mt-6 grid grid-cols-2 gap-4 sm:gap-grid md:grid-cols-3 lg:grid-cols-4" id="people">
      {people.map((e) => (
        <PersonCard
          entry={e}
          job={web?.get(e.data.name)}
          listed={!unlisted(e.data.name)}
          data-name={e.data.name.toLowerCase()}
          data-draft={e.data.status === "draft" ? "" : undefined}
          data-unlisted={unlisted(e.data.name) ? "" : undefined}
        />
      ))}
    </ul>
    <p class="mt-6 text-muted" id="none" hidden>
      Nobody matches.
    </p>
  </div>
</Layout>

<script>
  // The filters need script, so they show only where it runs; without it the full grid stays.
  const find = document.querySelector<HTMLInputElement>("#find")!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const cards = [...document.querySelectorAll<HTMLElement>("#people > [data-name]")];
  let filter = "all";
  const apply = () => {
    const q = find.value.trim().toLowerCase();
    for (const card of cards)
      card.hidden =
        !card.dataset.name!.includes(q) || (filter !== "all" && !(filter in card.dataset));
    document.querySelector<HTMLElement>("#none")!.hidden = cards.some((card) => !card.hidden);
  };
  find.addEventListener("input", apply);
  for (const button of buttons)
    button.addEventListener("click", () => {
      filter = button.dataset.filter!;
      for (const b of buttons) b.setAttribute("aria-pressed", String(b === button));
      apply();
    });
  document.querySelector<HTMLElement>("#controls")!.hidden = false;
</script>
