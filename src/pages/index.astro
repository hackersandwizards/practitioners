---
// Everyone in this repo as hackersandwizards.dev/team/ shows them, each card opening the person's
// page, grouped by who they work for: h&w itself, a company (sorted by it, so colleagues stand
// together), freelance, or not stated yet. The website's own grouping and roles stay the website's
// (lib/website.ts).
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PersonCard from "../components/PersonCard.astro";
import { repo, shown } from "../lib/entry";
import { ownAffiliations } from "../lib/schema";
import { listing, roster, team } from "../lib/website";

const web = await roster();
const people = (await getCollection("practitioners", (e) => shown(e.data)))
  .sort((a, b) => a.data.name.localeCompare(b.data.name))
  .map((entry) => ({ entry, ...listing(web, entry.data.name) }));
// A filter that would show nobody, such as drafts in a public build, is left out.
const filters = [
  { key: "all", label: "All", count: people.length },
  {
    key: "draft",
    label: "Drafts",
    count: people.filter((p) => p.entry.data.status === "draft").length,
  },
  { key: "unlisted", label: "Not on the website", count: people.filter((p) => !p.listed).length },
].filter((f) => f.key === "all" || f.count > 0);
// Sorted by affiliation, which keeps the names in order within one company.
const byGroup = Map.groupBy(
  people.toSorted((a, b) =>
    (a.entry.data.affiliation ?? "").localeCompare(b.entry.data.affiliation ?? ""),
  ),
  ({ entry: { data } }) =>
    !data.affiliation ? "none" : data.affiliation in ownAffiliations ? data.affiliation : "company",
);
const groups = [
  { key: "hackers&wizards", label: ownAffiliations["hackers&wizards"] },
  { key: "company", label: "At a company" },
  { key: "freelance", label: ownAffiliations.freelance },
  { key: "none", label: "Not stated yet" },
]
  .map((g) => ({ ...g, people: byGroup.get(g.key) ?? [] }))
  .filter((g) => g.people.length);
---

<Layout
  title="Practitioners"
  description="Every hackers&wizards practitioner's entry, as hackersandwizards.dev/team shows it."
>
  <div class="mx-auto w-full max-w-content px-gutter pb-section">
    <h1 class="mt-8 font-mono text-h2 font-bold tracking-tight">Practitioners</h1>
    <p class="mt-2 max-w-measure text-muted">
      Each card shows a person as{" "}
      <a href={team} class="hw-link">
        hackersandwizards.dev/team
      </a>{" "}
      shows them. Open a card to read and check the full entry.
    </p>
    <p class="mt-3 max-w-measure text-small text-muted">
      Each person improves their own entry by pull request, as{" "}
      <a href={`${repo}/blob/main/CONTRIBUTING.md`} class="hw-link">
        CONTRIBUTING.md
      </a>{" "}
      describes.
    </p>
    {!web && (
      <p class="mt-3 hw-callout max-w-measure text-small">
        The website's team page could not be read when this page was built, so roles and who is not
        on the website yet are missing.
      </p>
    )}

    <div class="mt-8 flex flex-wrap items-center gap-4" id="controls">
      <input
        type="search"
        id="find"
        class="hw-field w-full sm:w-72"
        placeholder="Find a name"
        aria-label="Find a name"
        aria-controls="people"
      />
      <div class="hw-segmented max-sm:flex max-sm:w-full" role="group" aria-label="Show">
        {filters.map((f) => (
          <button
            type="button"
            class="max-sm:grow"
            data-filter={f.key}
            aria-pressed={f.key === "all" ? "true" : "false"}
          >
            {f.label} {f.count}
          </button>
        ))}
      </div>
    </div>

    <div id="people">
      {groups.map((g, i) => (
        <section class="mt-10">
          <h2 class="font-mono text-h4 font-bold">
            {g.label} <span class="text-muted">{g.people.length}</span>
          </h2>
          <ul class="mt-4 grid grid-cols-2 gap-4 sm:gap-grid md:grid-cols-3 lg:grid-cols-4">
            {g.people.map((p, j) => (
              <PersonCard
                entry={p.entry}
                job={p.job}
                company={g.key === "company" ? p.entry.data.affiliation : undefined}
                listed={p.listed}
                sizes="(min-width: 1024px) 210px, (min-width: 768px) 25vw, 40vw"
                priority={i === 0 && j === 0}
              />
            ))}
          </ul>
        </section>
      ))}
    </div>
    <p class="mt-6 text-muted" id="none" hidden>
      Nobody matches.
    </p>
  </div>
</Layout>

<script>
  const find = document.querySelector<HTMLInputElement>("#find")!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const cards = [...document.querySelectorAll<HTMLElement>("#people [data-name]")];
  const sections = [...document.querySelectorAll<HTMLElement>("#people > section")];
  // "caluk" finds Čaluk and "buss" finds Buß.
  const fold = (s: string) =>
    s.normalize("NFD").replace(/\p{M}/gu, "").replace(/ß/g, "ss").toLowerCase();
  let filter = "all";
  const apply = () => {
    const q = fold(find.value.trim());
    for (const card of cards)
      card.hidden =
        !fold(card.dataset.name!).includes(q) || (filter !== "all" && !(filter in card.dataset));
    for (const section of sections)
      section.hidden = !section.querySelector("[data-name]:not([hidden])");
    document.querySelector<HTMLElement>("#none")!.hidden = cards.some((card) => !card.hidden);
  };
  find.addEventListener("input", apply);
  for (const button of buttons)
    button.addEventListener("click", () => {
      filter = button.dataset.filter!;
      for (const b of buttons) b.setAttribute("aria-pressed", String(b === button));
      apply();
    });
  // The browser restores a typed search on back or reload after this script runs.
  addEventListener("pageshow", apply);
</script>

<style>
  /* The filters render visible, so the grid never shifts when the script starts. They need the
     script, so a browser without it hides them. */
  @media (scripting: none) {
    #controls {
      display: none;
    }
  }
</style>
