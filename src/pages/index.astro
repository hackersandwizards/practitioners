---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { links, shown } from "../lib/entry";

/** Preview of what hackersandwizards.dev renders from this repo: every entry, alphabetical.
 *  Grouping and roles are the website's roster, so nothing here is grouped. */
const people = (await getCollection("practitioners", (e) => shown(e.data))).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const german = new Map((await getCollection("practitionersDe")).map((e) => [e.id, e]));

const cards = await Promise.all(
  people.map(async (entry) => {
    const de = german.get(entry.id);
    return {
      entry,
      En: (await render(entry)).Content,
      De: de ? (await render(de)).Content : undefined,
    };
  }),
);
---

<Layout title="Practitioners">
  <h1 class="mt-8 font-mono text-2xl font-bold tracking-tight">Practitioners</h1>
  <p class="mt-2 max-w-2xl text-sm text-muted">
    Each entry is the source for{" "}
    <a href="https://www.hackersandwizards.dev/team/" class="hw-link">
      hackersandwizards.dev/team
    </a>
    , so what you read here is what a client reads there.
  </p>
  <p class="mt-3 hw-callout max-w-2xl text-sm">
    <strong class="font-medium text-ink">How an entry gets finished:</strong> each person gets a
    mail that shows only their own entry and what it still lacks. They reply that it fits, send
    corrections or a new photo, or ask to be taken off. The reply lands here, and an entry turns
    active only after their yes to the exact text. To write a bio from scratch, open Claude in this
    repo and say <em>"create my bio"</em>.
  </p>

  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {cards.map(({ entry, En, De }) => (
      <article class="flex flex-col rounded-lg border p-5">
        <Image
          src={entry.data.photo}
          alt={entry.data.name}
          width={480}
          height={480}
          class="aspect-square w-full rounded-lg object-cover"
        />
        <h2 class="mt-4 font-mono font-bold">
          <a href={`/${entry.id}/`} class="hover:text-teal-dark">
            {entry.data.name}
          </a>{" "}
          {entry.data.status === "draft" && (
            <span class="ml-2 rounded border px-1.5 py-0.5 align-middle font-mono text-[10px] font-normal text-muted">
              draft
            </span>
          )}
        </h2>
        <div class="prose-content mt-3 text-sm">
          <En />
        </div>
        {De && (
          <div class="prose-content mt-3 border-t pt-3 text-sm">
            <span class="font-mono text-[10px] text-muted">DE</span>
            <De />
          </div>
        )}
        <div class="mt-auto flex flex-wrap gap-2 pt-4">
          {links(entry.data).map((l) => (
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded border px-2 py-1 text-xs hover:text-teal-dark"
            >
              {l.label}
            </a>
          ))}
        </div>
      </article>
    ))}
  </div>
</Layout>
