---
// Everyone in this repo as hackersandwizards.dev/team/ shows them, each card opening the person's
// page, grouped by who they work for: h&w itself, a company (sorted by it, so colleagues stand
// together), freelance, or not stated yet. The website's own grouping and roles stay the website's
// (lib/website.ts).
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import type { FilterItem } from "@hackersandwizards/brand/elements/list-filter.ts";
import ListFilter from "@hackersandwizards/brand/expert/components/ListFilter.astro";
import PersonCard from "../components/PersonCard.astro";
import { repo, shown } from "../lib/entry";
import { ownAffiliations } from "../lib/schema";
import { listing, roster, team } from "../lib/website";

const web = await roster();
const people = (await getCollection("practitioners", (e) => shown(e.data)))
  .sort((a, b) => a.data.name.localeCompare(b.data.name))
  .map((entry) => ({ entry, ...listing(web, entry.data.name) }));
const item = (p: (typeof people)[number]): FilterItem => ({
  text: p.entry.data.name.toLowerCase(),
  facets: { entry: [p.entry.data.status], web: [p.listed ? "listed" : "unlisted"] },
});
// Sorted by affiliation, which keeps the names in order within one company.
const byGroup = Map.groupBy(
  people.toSorted((a, b) =>
    (a.entry.data.affiliation ?? "").localeCompare(b.entry.data.affiliation ?? ""),
  ),
  ({ entry: { data } }) =>
    !data.affiliation
      ? "none"
      : Object.hasOwn(ownAffiliations, data.affiliation)
        ? data.affiliation
        : "company",
);
const groups = [
  { key: "hackers&wizards", label: ownAffiliations["hackers&wizards"] },
  { key: "company", label: "At a company" },
  { key: "freelance", label: ownAffiliations.freelance },
  { key: "none", label: "Not stated yet" },
]
  .map((g) => ({ ...g, people: byGroup.get(g.key) ?? [] }))
  .filter((g) => g.people.length);
// The rows in the page's order: the filter's counts read them in it.
const placed = groups.flatMap((g) => g.people);
const items = placed.map(item);
// Whether someone's entry is done and whether the website lists them are separate questions, so
// each is its own facet and a person counts once in each. A facet with a value that shows nobody,
// such as the entry in a public build, splits nothing.
const facets = [
  {
    param: "entry",
    legend: "Entry",
    options: [
      { value: "draft", label: "Draft" },
      { value: "active", label: "Not a draft" },
    ],
  },
  {
    param: "web",
    legend: "Website",
    options: [
      { value: "listed", label: "On the website" },
      { value: "unlisted", label: "Not on the website" },
    ],
  },
].filter((f) => f.options.every((o) => items.some((i) => i.facets[f.param]?.includes(o.value))));
---

<Layout
  title="Practitioners"
  description="Every hackers&wizards practitioner's entry, as hackersandwizards.dev/team shows it."
>
  <div class="mx-auto w-full max-w-content px-gutter pb-section">
    <h1 class="mt-8 font-mono text-h2 font-bold tracking-tight">Practitioners</h1>
    <p class="mt-2 max-w-measure text-muted">
      Each card shows a person as{" "}
      <a href={team} class="hw-link">
        hackersandwizards.dev/team
      </a>{" "}
      shows them. Open a card to read and check the full entry.
    </p>
    <p class="mt-3 max-w-measure text-small text-muted">
      Each person improves their own entry by pull request, as{" "}
      <a href={`${repo}/blob/main/CONTRIBUTING.md`} class="hw-link">
        CONTRIBUTING.md
      </a>{" "}
      describes.
    </p>
    {!web && (
      <p class="mt-3 hw-callout max-w-measure text-small">
        The website's team page could not be read when this page was built, so roles and who is not
        on the website yet are missing.
      </p>
    )}

    <div class="mt-8" id="controls">
      <ListFilter
        id="find"
        action="/"
        label="Find a name"
        items={items}
        state={{ q: "", facets: {} }}
        facets={facets}
        count="{shown} of {total} people"
        copy={{
          all: "All",
          clear: "Clear all",
          empty: "Nobody matches.",
          submit: "Search",
          filters: "Filters",
        }}
      >
        {groups.map((g, i) => (
          <section class="mt-10 first:mt-4" data-filter-group>
            {/* No count here: it would not follow the search, and the filter's count line does. */}
            <h2 class="font-mono text-h4 font-bold">{g.label}</h2>
            {/* An off-screen card stands in at --hw-list-filter-row until it renders. The square
                portrait grows with the column, so the value follows the viewport per column count,
                fitted to the median card inside its padding: measured from 360 to 1920 px wide, the
                page moves by about 4 % at most as cards render, where brand's 3rem default moved it by 45 %. */}
            <ul class="mt-4 grid grid-cols-2 gap-4 [--hw-list-filter-row:max(18rem,43vw_+_5.3rem)] sm:gap-grid md:grid-cols-3 md:[--hw-list-filter-row:calc(27.5vw_+_5.5rem)] lg:grid-cols-4 lg:[--hw-list-filter-row:19.5rem]">
              {g.people.map((p, j) => (
                <PersonCard
                  entry={p.entry}
                  job={p.job}
                  company={g.key === "company" ? p.entry.data.affiliation : undefined}
                  listed={p.listed}
                  filter={item(p)}
                  sizes="(min-width: 1024px) 210px, (min-width: 768px) 25vw, 40vw"
                  priority={i === 0 && j === 0}
                />
              ))}
            </ul>
          </section>
        ))}
      </ListFilter>
    </div>
  </div>
</Layout>

<style>
  /* A static page has no server to apply the form's query, so without a script the search and
     its values would do nothing; the cards stay. */
  @media (scripting: none) {
    #controls :global(.hw-list-filter > form) {
      display: none;
    }
  }
</style>
