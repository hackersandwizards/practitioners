---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";

/** Preview of what hackersandwizards.dev renders from this repo: every entry, alphabetical.
 *  Grouping and roles are the website's roster, so nothing here is grouped. */
const people = (await getCollection("practitioners")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const german = new Map((await getCollection("practitionersDe")).map((e) => [e.id, e]));

const cards = await Promise.all(
  people.map(async (entry) => {
    const de = german.get(entry.id);
    return {
      entry,
      En: (await render(entry)).Content,
      De: de ? (await render(de)).Content : undefined,
    };
  }),
);

/** Only the profiles a practitioner actually maintains render; a dead link is worse than none. */
const links = (d: (typeof people)[number]["data"]) =>
  [
    { label: "Bluesky", href: d.bluesky },
    { label: "X", href: d.x },
    { label: "Threads", href: d.threads },
    { label: "Mastodon", href: d.mastodon },
    { label: "GitHub", href: d.github },
    { label: "Website", href: d.website },
    { label: "Book me", href: d.bookme },
  ].filter((l): l is { label: string; href: string } => Boolean(l.href));
---

<Layout title="Practitioners">
  <h1 class="mt-8 font-heading text-2xl font-bold tracking-tight">Practitioners</h1>
  <p class="mt-2 max-w-2xl text-sm text-foreground/60">
    Each entry is the source for
    <a href="https://www.hackersandwizards.dev/practitioners/" class="text-accent hover:underline"
      >hackersandwizards.dev/practitioners</a
    >, so what you read here is what a client reads there.
  </p>
  <p class="mt-3 max-w-2xl rounded-lg border bg-muted/30 p-4 text-sm text-foreground/70">
    <strong class="font-medium text-foreground">Your entry is missing or stale?</strong> Open Claude in
    this repo and say <em>"create my bio"</em>. It interviews you, collects your links and portrait,
    drafts the English and the German text, shows you the result here, and commits once you approve.
    Ten minutes, once.
  </p>

  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      cards.map(({ entry, En, De }) => (
        <article class="flex flex-col rounded-lg border p-5">
          <Image
            src={entry.data.photo}
            alt={entry.data.name}
            width={480}
            height={480}
            class="aspect-square w-full rounded-lg object-cover"
          />
          <h2 class="mt-4 font-heading font-bold">
            {entry.data.linkedin || entry.data.website ? (
              <a
                href={entry.data.linkedin ?? entry.data.website}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-accent"
              >
                {entry.data.name}
              </a>
            ) : (
              entry.data.name
            )}
            {entry.data.status === "draft" && (
              <span class="ml-2 rounded border px-1.5 py-0.5 align-middle font-mono text-[10px] font-normal text-foreground/50">
                draft
              </span>
            )}
          </h2>
          <div class="prose-content mt-3 text-sm">
            <En />
          </div>
          {De && (
            <div class="prose-content mt-3 border-t pt-3 text-sm">
              <span class="font-mono text-[10px] text-foreground/50">DE</span>
              <De />
            </div>
          )}
          <div class="mt-auto flex flex-wrap gap-2 pt-4">
            {links(entry.data).map((l) => (
              <a
                href={l.href}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded border px-2 py-1 text-xs hover:bg-muted/50"
              >
                {l.label}
              </a>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</Layout>
