---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Links from "../components/Links.astro";
import { repo, shown } from "../lib/entry";

/** Preview of what hackersandwizards.dev renders from this repo: every entry, alphabetical.
 *  Grouping and roles are the website's roster, so nothing here is grouped. */
const people = (await getCollection("practitioners", (e) => shown(e.data))).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const german = new Map((await getCollection("practitionersDe")).map((e) => [e.id, e]));

const cards = await Promise.all(
  people.map(async (entry) => {
    const de = german.get(entry.id);
    return {
      entry,
      En: (await render(entry)).Content,
      De: de ? (await render(de)).Content : undefined,
    };
  }),
);
---

<Layout title="Practitioners">
  <h1 class="mt-8 font-mono text-2xl font-bold tracking-tight">Practitioners</h1>
  <p class="mt-2 max-w-2xl text-sm text-muted">
    Each entry is the source for{" "}
    <a href="https://www.hackersandwizards.dev/team/" class="hw-link">
      hackersandwizards.dev/team
    </a>
    , so what you read here is what a client reads there.
  </p>
  <p class="mt-3 hw-callout max-w-2xl text-sm">
    <strong class="font-medium text-ink">How an entry gets finished:</strong> each person improves
    their own folder through a pull request, in the browser or with Claude Code, and h&w merges it.
    Their pull request, or their reply that it fits, is their yes.{" "}
    <a href={`${repo}/blob/main/CONTRIBUTING.md`} class="hw-link">
      CONTRIBUTING.md
    </a>{" "}
    says how.
  </p>

  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {cards.map(({ entry, En, De }) => (
      <article class="flex flex-col rounded-brand border p-5">
        <Image
          src={entry.data.photo}
          alt={entry.data.name}
          width={480}
          height={480}
          class="aspect-square w-full rounded-brand object-cover"
        />
        <h2 class="mt-4 font-mono font-bold">
          <a href={`/${entry.id}/`} class="hover:text-teal-dark">
            {entry.data.name}
          </a>{" "}
          {entry.data.status === "draft" && (
            <span class="hw-pill ml-2 align-middle" data-variant="outline">
              draft
            </span>
          )}
        </h2>
        <div class="prose hw-prose mt-3 max-w-none text-sm">
          <En />
        </div>
        {De && (
          <div lang="de" class="prose hw-prose mt-3 max-w-none border-t pt-3 text-sm">
            <span class="hw-label" data-tone="muted">
              DE
            </span>
            <De />
          </div>
        )}
        <Links data={entry.data} class="mt-auto pt-4" />
      </article>
    ))}
  </div>
</Layout>
