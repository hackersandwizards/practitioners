---
import AppHeader from "@hackersandwizards/brand/expert/components/AppHeader.astro";
import ThemeToggle from "@hackersandwizards/brand/expert/components/ThemeToggle.astro";
import "../styles/global.css";

interface Props {
  title: string;
  /** A page whose content runs edge to edge, such as a profile with its night hero. */
  bleed?: boolean;
}
const { title, bleed = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="hw-focus-ring" data-hw-night>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{title} | hackers&wizards</title>
    <link rel="icon" type="image/png" href="/hw-emoji.png" />
    {/* Applied before first paint, or the wrong theme flashes. */}
    <script is:inline>
      const theme =
        localStorage.getItem("theme") ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.setAttribute("data-theme", theme);
    </script>
  </head>
  <body>
    <AppHeader product="Practitioners">
      <ThemeToggle />
    </AppHeader>
    <main class:list={["w-full flex-1", !bleed && "hw-container pb-16"]}>
      <slot />
    </main>
  </body>
</html>
