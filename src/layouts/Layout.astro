---
import AppHeader from "@hackersandwizards/brand/expert/components/AppHeader.astro";
import ThemeToggle from "@hackersandwizards/brand/expert/components/ThemeToggle.astro";
import faviconIco from "@hackersandwizards/brand/logos/favicon.ico?url";
import faviconSvg from "@hackersandwizards/brand/logos/favicon.svg?url";
import { review } from "../lib/entry";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" class="hw-focus-ring" data-hw-night>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="description" content={description} />
    <title>{title} | hackers&wizards</title>
    <link rel="icon" href={faviconIco} sizes="32x32" />
    <link rel="icon" href={faviconSvg} type="image/svg+xml" />
    {/* Applied before first paint, or the wrong theme flashes. */}
    <script is:inline>
      const theme =
        localStorage.getItem("theme") ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.setAttribute("data-theme", theme);
    </script>
  </head>
  <body>
    <AppHeader product="Practitioners">
      {
        /* The catalog builds only where drafts render (astro.config.ts); a public build has no
           link, so no nav. */
        review ? (
          <nav class="hw-header-nav" aria-label="Main">
            <a class="hw-header-link" href="/catalog/">
              Catalog
            </a>
            <ThemeToggle />
          </nav>
        ) : (
          <ThemeToggle />
        )
      }
    </AppHeader>
    <main class="w-full flex-1">
      <slot />
    </main>
  </body>
</html>
