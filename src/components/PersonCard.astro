---
// One person as the website's team grid shows them: portrait, name, the website's role and
// credential line, and a link to their profile there. The card opens the detail page through the
// name's link, stretched over the card; its arrow says the card opens something. The profile link
// sits above that stretch (brand's card.css).
// The hub adds what the website never shows: a draft, and someone the website does not list yet.
// The data-filter-* attributes are what the overview's list filter reads (brand's ListFilter).
import type { CollectionEntry } from "astro:content";
import type { FilterItem } from "@hackersandwizards/brand/elements/list-filter.ts";
import Portrait from "./Portrait.astro";

interface Props {
  entry: CollectionEntry<"practitioners">;
  /** The website's role line; undefined when the website does not list the person. */
  job?: string;
  /** The website's credential line under the role, where it prints one. */
  description?: string;
  /** Their profile on the website. */
  url?: string;
  /** The company they work for, where the overview's section heading does not already say it. */
  company?: string;
  /** False when the website's team roster was read and does not list the person. */
  listed: boolean;
  /** The card as the overview's list filter reads it. */
  filter?: FilterItem;
  /** The card's rendered width, from the grid that places it. */
  sizes: string;
  /** The first card holds the largest paint above the fold, so its portrait loads first. */
  priority?: boolean;
}
const { entry, job, description, url, company, listed, filter, sizes, priority } = Astro.props;
const { data } = entry;
---

<li
  class="hw-card min-w-0 [--hw-card-pad:1rem]"
  data-filter-item={filter && ""}
  data-filter-text={filter?.text}
  data-filter-facets={filter && JSON.stringify(filter.facets)}
>
  <Portrait
    data={data}
    alt=""
    widths={[240, 320, 480, 640]}
    sizes={sizes}
    priority={priority}
    class="aspect-square w-full"
  />
  <p class="mt-4 font-medium hyphens-auto text-ink">
    <a href={`/${entry.id}/`} class="hw-card-link">
      <span data-filter-title>{data.name}</span>
      <span class="hw-arrow" aria-hidden="true">
        &nbsp;<span>→</span>
      </span>
    </a>
  </p>
  {[job, description, company].map(
    (line) => line && <p class="mt-tight text-small text-muted">{line}</p>,
  )}
  {url && (
    <p class="mt-tight text-small">
      <a href={url} class="hw-link" aria-label={`${data.name} on the website`}>
        On the website
      </a>
    </p>
  )}
  {(data.status === "draft" || !listed) && (
    <p class="mt-3 flex flex-wrap gap-1.5">
      {data.status === "draft" && (
        <span class="hw-pill" data-state="draft">
          Draft
        </span>
      )}
      {!listed && (
        <span class="hw-pill" data-variant="outline">
          Not on the website
        </span>
      )}
    </p>
  )}
</li>
