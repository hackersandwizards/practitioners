---
// One person as the website's team grid shows them: portrait, name, the website's role. The whole
// card opens the detail page through the name's link, stretched over the card, so the card holds
// one link named by the person; its arrow says the card opens something.
// The hub adds what the website never shows: a draft, and someone the website does not list yet.
// data-name, data-draft and data-unlisted are what the overview's filter reads.
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  entry: CollectionEntry<"practitioners">;
  /** The website's role line; undefined when the website does not list the person. */
  job?: string;
  /** False when the website's team page was read and does not list the person. */
  listed: boolean;
  /** The first card holds the largest paint above the fold, so its portrait loads first. */
  priority?: boolean;
}
const { entry, job, listed, priority } = Astro.props;
const { data } = entry;
---

<li
  class="hw-card min-w-0 [--hw-card-pad:1rem]"
  data-name={data.name}
  data-draft={data.status === "draft" ? "" : undefined}
  data-unlisted={listed ? undefined : ""}
>
  <Image
    src={data.photo}
    alt=""
    width={480}
    height={480}
    priority={priority}
    class="aspect-square w-full rounded-brand object-cover"
  />
  <p class="mt-4 font-medium hyphens-auto text-ink">
    <a href={`/${entry.id}/`} class="hw-card-link">
      <span>{data.name}</span>
      <span class="hw-arrow" aria-hidden="true">
        &nbsp;<span>→</span>
      </span>
    </a>
  </p>
  {job && <p class="mt-1 text-small text-muted">{job}</p>}
  {(data.status === "draft" || !listed) && (
    <p class="mt-3 flex flex-wrap gap-1.5">
      {data.status === "draft" && (
        <span class="hw-pill" data-state="draft">
          Draft
        </span>
      )}
      {!listed && (
        <span class="hw-pill" data-variant="outline">
          Not on the website
        </span>
      )}
    </p>
  )}
</li>
