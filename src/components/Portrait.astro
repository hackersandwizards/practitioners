---
// The practitioner's square portrait, or their initials on a plain square while the entry has none:
// a seed h&w starts before the person sends a photo.
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { bareName } from "../lib/entry";

interface Props {
  data: CollectionEntry<"practitioners">["data"];
  alt: string;
  widths: number[];
  sizes: string;
  priority?: boolean;
  class?: string;
}
const { data, alt, widths, sizes, priority, class: className } = Astro.props;
const initials = bareName(data.name)
  .split(/\s+/)
  .map((w) => w[0])
  .filter((_, i, all) => i === 0 || i === all.length - 1)
  .join("");
---

{data.photo ? (
  <Image
    src={data.photo}
    alt={alt}
    width={480}
    height={480}
    widths={widths}
    sizes={sizes}
    priority={priority}
    class:list={["rounded-brand object-cover", className]}
  />
) : (
  <div
    role={alt ? "img" : undefined}
    aria-label={alt || undefined}
    class:list={[
      "grid place-items-center rounded-brand bg-tint font-mono text-h2 font-bold text-muted",
      className,
    ]}
  >
    <span aria-hidden="true">{initials}</span>
  </div>
)}
