#!/usr/bin/env bash
set -e
# core.quotePath=false, or git escapes umlaut paths and the anchored patterns below miss them.
# --no-renames lists a moved file's old path too, so moving a file out of app code runs the gate.
staged=$(git -c core.quotePath=false diff --cached --name-only --no-renames --diff-filter=ACMDT)
content_re='^src/content/'
docs_re='^(src/content/|\.claude/|README\.md$|CLAUDE\.md$)'

for dir in $(echo "$staged" | grep -Eo '^src/content/practitioners/[^/]+/' | sort -u); do
  untracked=$(git ls-files --others --exclude-standard -- "$dir")
  if ! git diff --quiet -- "$dir" || [ -n "$untracked" ]; then
    echo "[pre-commit] $dir differs from the index: run bun run export, stage the whole folder"
    exit 1
  fi
done

if echo "$staged" | grep -Ev "$docs_re" | grep -q .; then
  echo "[pre-commit] app code changed -> bun run check"
  bun run check
else
  if echo "$staged" | grep -Eq "$content_re"; then
    # Those checks read the code in the working tree, so code this commit leaves out would decide it.
    code=(. ':!src/content' ':!.claude' ':!docs' ':!*.md' ':!bun.lock')
    other=$(git diff --name-only -- "${code[@]}"; git ls-files --others --exclude-standard -- "${code[@]}")
    if [ -n "$other" ]; then
      echo "[pre-commit] the checks would read code this commit leaves out; commit, restore or remove:"
      echo "$other"
      exit 1
    fi
    echo "[pre-commit] content changed -> validating bios against the schema, entry.json fresh"
    bun run typecheck
    bun test ./src/lib/export.test.ts || { echo "[pre-commit] run bun run export and stage each entry.json"; exit 1; }
  fi
  # Only h&w commits outside src/content/ and can fetch the confidential list, so such a commit
  # needs it. A practitioner's own commit passes without the list; with it, h&w's is scanned.
  # Nothing here scans the commit message.
  if echo "$staged" | grep -Ev "$content_re" | grep -q .; then
    bun run check-confidential --staged
  else
    bun run check-confidential --staged --list-optional
  fi
fi
