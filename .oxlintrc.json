{
  "extends": ["./node_modules/@hackersandwizards/scaffolding/config/oxlint.json"],
  "plugins": ["typescript"],
  "env": { "browser": true, "node": true, "bun": true },
  "options": { "typeAware": true },
  "ignorePatterns": [
    "node_modules/**",
    "coverage/**",
    "**/dist/**",
    "**/.astro/**",
    "/.claude/**",
    "/.agents/**",
    "/.githooks/**",
    ".preview/**",
    "src/content/**"
  ],
  "overrides": [
    {
      "files": ["src/lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [{ "regex": "^(\\.\\./)+(?:src/)?(components|layouts|pages)/" }]
          }
        ]
      }
    },
    {
      "files": ["src/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [{ "regex": "^(\\.\\./)+(?:src/)?(layouts|pages)/" }]
          }
        ]
      }
    }
  ]
}
